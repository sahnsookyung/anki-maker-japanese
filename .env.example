# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend
API_BASE_URL=http://localhost:8000
ANKI_MAKER_DB=app.db

# OCR provider: paddle by default; tesseract/google_vision are explicit diagnostics.
OCR_PROVIDER=paddle
OCR_PROVIDER_CACHE_ENABLED=true
OCR_COMPARE_PROVIDER=google_vision
GOOGLE_VISION_ALLOW_CLOUD=false
GOOGLE_VISION_CACHE_ENABLED=true
GOOGLE_VISION_MONTHLY_CAP=1000
# Optional: us-vision.googleapis.com or eu-vision.googleapis.com for regional processing.
GOOGLE_VISION_API_ENDPOINT=
PREPROCESS_MAX_SIDE_LEN=1800
OCR_PAGE_WORKER_MAX_RSS_MB=6144
OCR_VL_PAGE_WORKER_MAX_RSS_MB=14336
OCR_PAGE_JOB_TIMEOUT_SECONDS=300
PADDLE_OCR_MAX_SIDE_LEN=1600
PADDLE_OCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLE_OCR_USE_DOC_UNWARPING=false
PADDLE_OCR_USE_TEXTLINE_ORIENTATION=false
PADDLE_OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv3_mobile_det
PADDLE_OCR_TEXT_RECOGNITION_MODEL_NAME=japan_PP-OCRv3_mobile_rec
PADDLE_OCR_KOREAN_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
PADDLE_OCR_KOREAN_TEXT_RECOGNITION_MODEL_NAME=korean_PP-OCRv5_mobile_rec
VOCAB_DUAL_OCR_ENABLED=true
PADDLE_OCR_VL_BACKEND=
PADDLE_OCR_VL_SERVER_URL=
PADDLE_OCR_VL_API_MODEL_NAME=
PADDLE_OCR_VL_API_KEY=
PADDLE_OCR_VL_MAX_PIXELS=1000000
PADDLE_OCR_VL_MAX_NEW_TOKENS=1024
PADDLE_OCR_VL_USE_LAYOUT_DETECTION=false

# Single local Qwen model through Ollama
VLM_CLEANUP_ENABLED=false
VLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional llama.cpp OpenAI-compatible vision server
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_MODEL=Qwen3-VL-8B-Instruct

# Google Cloud Vision uses service-account credentials, not GOOGLE_API_KEY
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials/google-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional local dictionary JSON: [{"surface":"学校","reading":"がっこう"}]
DICTIONARY_PATH=backend/data/dictionaries/jlpt_basic_ko.json
KOREAN_GLOSSARY_PATH=backend/data/dictionaries/jlpt_basic_ko.json
